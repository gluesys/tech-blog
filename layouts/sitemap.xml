{{- /* Default sitemap, except that "/dir/index.html" is listed as "/dir/" (uglyURLs for
       the blog section would otherwise expose the /blog/ alias file name) and pages that
       are not rendered (no permalink, e.g. the /authors/ section) are left out. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
  {{- if or .Sitemap.Disable (not .Permalink) }}{{ else }}
  <url>
    <loc>{{ .Permalink | replaceRE "index\\.html$" "" }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>{{ end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
